# URL users should return to after clicking the email link.
FRONTEND_URL=http://localhost:3000

# SMTP settings. The defaults suit providers that use STARTTLS on port 587.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=StrydeX
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Set a long random value and keep it stable, or reset links become invalid
# whenever this value changes.
SECRET_KEY=replace-with-a-long-random-secret
